{
  "doctype": "DocType",
  "name": "Chatbot Knowledge",
  "module": "ERPNextUSA AI Chatbot",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "engine": "InnoDB",
  "field_order": [
    "title",
    "published",
    "priority",
    "category",
    "keywords",
    "question",
    "answer",
    "content",
    "source_url",
    "likes"
  ],
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "published",
      "label": "Published",
      "fieldtype": "Check",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Int",
      "default": "0"
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Data"
    },
    {
      "fieldname": "keywords",
      "label": "Keywords",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "question",
      "label": "Question",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "answer",
      "label": "Answer",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "content",
      "label": "Content",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "source_url",
      "label": "Source URL",
      "fieldtype": "Data"
    },
    {
      "fieldname": "likes",
      "label": "Likes",
      "fieldtype": "Int",
      "default": "0",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "track_changes": 1,
  "allow_rename": 0
}
